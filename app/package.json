{
  "name": "nextant-solution-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:connected": "vite --config connected/vite.config.ts",
    "dev:media": "node scripts/local-media/dev.mjs",
    "cleanup:media": "node scripts/local-media/maintenance.mjs",
    "migration:media": "node scripts/media-migration.mjs",
    "test:migration": "node --test scripts/media-migration.test.mjs",
    "check:infra": "node scripts/verify-media-infra.mjs",
    "test:media": "node --test scripts/local-media/*.test.mjs",
    "test:media:edge": "node scripts/local-media/acceptance-edge.mjs",
    "test:media:attachments": "node scripts/local-media/acceptance-edge.mjs --attachments",
    "check:media": "tsc --project local-media/tsconfig.json",
    "build:connected": "tsc --project connected/tsconfig.json && vite build --config connected/vite.config.ts",
    "test:connected": "node --experimental-strip-types --test connected/src/*.test.ts",
    "test:ui": "node --test scripts/ui.test.mjs",
    "build": "tsc -b && vite build",
    "build:presentation": "tsc -b && node scripts/build-submission.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "preview": "vite preview"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@microsoft/power-apps": "^1.2.5",
    "hash-wasm": "^4.12.0",
    "mp4box": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.33.0",
    "@eslint/js": "^9.39.1",
    "@microsoft/power-apps-cli": "1.0.2",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "azurite": "3.37.0",
    "cfb": "1.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ffmpeg-static": "5.3.0",
    "globals": "^16.5.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.63.0",
    "pptxgenjs": "4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
